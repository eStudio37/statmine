{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/sync.sh"],
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": ["--no-env-file", "--config=/dev/null", "run", "${CLAUDE_PLUGIN_ROOT}/hooks/on-prompt.ts"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
