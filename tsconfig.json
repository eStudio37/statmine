{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["hooks/**/*.ts", "tests/**/*.ts"]
}
